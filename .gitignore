# =========================
#  General Node.js ignores
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
#  Build and output folders
# =========================
dist/
build/
out/
coverage/
.tmp/
.cache/
*.tsbuildinfo

# =========================
#  Environment files
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
server/.env

# =========================
#  Logs
# =========================
logs/
*.log
*.log.*
server/logs/
client/logs/

# =========================
#  System and IDE files
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =========================
#  Docker related (optional)
# =========================
# You usually want to ignore these only if they're generated dynamically.
# Keep docker-compose.yml and Dockerfile tracked if they're part of your setup.
**/docker-volume/
**/tmp-data/
**/db-data/

# =========================
#  GitHub Actions cache
# =========================
.github/workflows/*.log
.github/workflows/.cache/

# =========================
#  Frontend (React) specific
# =========================
client/build/
client/.next/
client/out/
client/.parcel-cache/
client/coverage/
client/node_modules/

# =========================
#  Backend (Server) specific
# =========================
server/dist/
server/node_modules/
server/tmp/
server/coverage/

# =========================
#  Misc
# =========================
*.pid
*.seed
*.tgz
*.tar.gz
*.swp
*.swo
